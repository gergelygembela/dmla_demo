    @Test= {
        Name = "Slot_5";
        Category = "Slot";
        Desc = "Slot with implicit constraints only";
    }
    entity Test_Slot_5 : Classifier {
        //This must be valid, since cloned constraints are defined on the slot
        new slot NewSlotWithoutConstraints : Base.Fields;
    }

    @Test= {
        Name = "Slot_5i";
        Category = "Slot";
        Desc = "Slot name does not collide during refinement";
    }
    entity Test_Slot_5i : Test_Slot_5 {
