package TestBench {
    import Bootstrap

    entity MyContract : Contract {
        //@FinalInstance
        @Type = {TypeName = Number;}
        @Cardinality = {Min = 1; Max = 1;}       
        slot C=6;

        @Type = {TypeName = String;}
        slot B;
    }

    entity TestBase: Classifier {

    }

    @MyContract
    entity A: TestBase {
        @Type = {TypeName = Number;}        
      //  @FinalInstance
        @Cardinality = {Min = 1; Max = 1;}
        slot C=6;
       
        @Type = {TypeName = String;}
        @Cardinality = {Min = 1; Max = 1;}
        slot B;
    }

    /*entity A2: A {
        
        @Type={TypeName=String;}
        slot B;
    }*/

    /*@MyContract
    entity B: TestBase {
        @Type = {TypeName = Number;}
        @Cardinality = {Min = 1; Max = 1;}
        slot C;

        @Type = {TypeName=Number;}
        slot B;
    }*/

    @FinalInstance
    entity C: Classifier {
        @Cardinality={Min=1; Max=1;}
        slot A=TestBench.A;
    }

    operation Bool RunAllTests() {
        foreach (Base subject in GetInstances(Contract, true)) {
            PrintLn("${GetID(subject)} --------------------------------");
            PrintLn("${ValidateSelf(subject)}");
        }
        return true;
    }

}