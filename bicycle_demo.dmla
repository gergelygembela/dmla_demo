package BicycleDemo {
    import Bootstrap
    import BicycleDomain

    operation BicycleComponent InitComponent(BicycleComponent subject, String serial) {
        return  subject
                    .Set(Component.Size, 25)
                    .Set(Component.Colour, "Black")
                    .Set(Component.SerialNumber, serial)
                    .Set(Component.Weight, 10)
                    .Set(BicycleComponent.Material, Material_Aluminium);
    }

    operation Bicycle CreateTestBike(){
        Bicycle bike = Create(ChallengerA2XL, "Bike134123")
                .Set(ClassicBike.FrontWheel,InitComponent(Create(WheelComponent, null), "s1341232"))
                .Set(ClassicBike.RearWheel, InitComponent(Create(WheelComponent, null), "s1341233"))
                .Set(RaceBike.Fork,         InitComponent(Create(RacingForkComponent, null), "s1341234"))
                .Set(ClassicBike.Seat,      InitComponent(Create(SeatComponent, null), "s1341235"))
                .Set(ChallengerA2XL.Frame,  
                    InitComponent(Create(RocketA1XL, null), "s1341236")
                    .Set(RacingFrameComponent.TopTubeLength, 100)
                    .Set(RacingFrameComponent.DownTubeLength, 80)
                    .Set(RacingFrameComponent.SeatTubeLength, 10));

        ValidateNPrint(bike);
        return bike;
    }

    operation void CreateTestSellAct(){
        SellingAct act1 = Create(SellingAct, null)
                .Set(SellingAct.SellDate, Create(DateTime, null).Set(DateTime.Year, 2017))
                .Set(SellingAct.SoldTo, Create(Person, "SusanStorm"))
                .Set(SellingAct.SellingPrice, 4299)
                .Set(SellingAct.Invoice, Create(Invoice, null))
                .Set(SellingAct.SoldBicycle, CreateTestBike())
                ;
    }

    operation void ValidateNPrint(Base ent){
        String? errorMsg = ValidateSelf(ent);
        if (errorMsg!=null) 
            PrintError("Error: '${errorMsg}'");
    }

    operation void UnitTests(){
        ValidateNPrint(Create(RocketA1XL, null).Set(BicycleComponent.Material, Material_Plastic));

        ValidateNPrint(Create(Bicycle, null).Set(Bicycle.IsEquippedWIthElectricMotor, true));

        ValidateNPrint(Create(ProRaceFrameComponent, null).Set(Component.Weight, 5920));

        ValidateNPrint(Create(RocketA1XL, null).Set(BicycleComponent.Material,Material_Steel));

        ValidateNPrint(Create(ChallengerA2XL, null)
                        .Set(ClassicBike.FrontWheel,InitComponent(Create(WheelComponent, null), "s1341232"))
                        .Set(ClassicBike.RearWheel, 
                            Create(WheelComponent, null)
                            .Set(Component.Size, 20)               
                        ));

        ValidateNPrint(Create(RocketA1XL, null).Set(BicycleComponent.Material,Material_Steel));

        ValidateNPrint(Create(ChallengerA2XL, null)
                        .Set(ClassicBike.RearWheel, InitComponent(Create(WheelComponent, null), "s11111")
                                                     .Set(BicycleComponent.Material, Material_Plastic))
                        .Set(ClassicBike.FrontWheel,InitComponent(Create(WheelComponent, null), "s1341232"))
                        .Set(ChallengerA2XL.Frame, Create(RocketA1XL, null)
                                                   .Set(BicycleComponent.Material, Material_Carbon))
                        );
 
        ValidateNPrint(Create(Bicycle, null)
                    .Set(Bicycle.IsEquippedWIthElectricMotor, true)
                    .Divide(Bicycle.OtherComponents, Create(BatteryComponent, null), "Battery")
                    .Divide(Bicycle.OtherComponents, Create(EnforcedBrakeComponent, null), "Brake"));
 
    }

    operation void TestIt(){
        Base b=CreateTestBike();//.Get(ClassicBike.FrontWheel);
       // AddAttribute(b, Create(Cardinality, "A").Set(Cardinality.Min, 3).Set(Cardinality.Max, 4));
       // b.AddAnnotation(FinalInstance);
        PrintEntity(b, true);
    }

    

    
 
}