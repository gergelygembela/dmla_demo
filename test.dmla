    }

    // -----------------------------------------------------------
    // ----------------------    Constraints    ------------------
    // -----------------------------------------------------------
    entity CustomConstraint : Annotation {

        override operation Bool Check(Base definedFor, Object appliesOn, Base? containerContext) {
            throw new ValidationException {
                ValidationSource = this;
                Meta = GetMeta(this);
                Instances = new Base[];
                Category = "Test/Constraints";
                ErrorCode = "Test_CC_1";
                Message = "Custom constraint - always fails";
            };
            return true;
        }
    }

    @CustomConstraint
    @Test= {
        Name = "Constraint_1";
        Category = "Constraint";
        Desc = "Custom constraint invalidates instance and the entity itself";
        ErrorMsg= "Custom constraint invalidates instance and the entity itself";
    }
    entity Test_Constraint : Classifier {
    }

    @Test= {
        Name = "Constraint_2";
        Category = "Constraint";
        Desc = "Custom constraint invalidates entity";
        ErrorMsg = "Custom constraint invalidates entity";
    }
    entity Test_Constrainti : Test_Constraint {
    }

    entity CustomConstraint2 : Annotation {
        override operation Bool Check(Base definedFor, Object appliesOn, Base? containerContext) {
            if (appliesOn!=Test_Constraint2)
            throw new ValidationException {
                ValidationSource = this;
                Meta = GetMeta(this);
                Instances = new Base[];
                Category = "Test/Constraints";
                ErrorCode = "Test_CC_2";
                Message = "Custom constraint - fails if not Test_Constraint2";
            };
            return true;
        }
    }

    @CustomConstraint2
    @Test={
        Name = "Constraint_2";
        Category = "Constraint";
        Desc = "Constraint applied on meta is satisfied by the meta";
    }
    entity Test_Constraint2 : Classifier {
    }

    @CustomConstraint2
    @Test={
        Name = "Constraint_2";
        Category = "Constraint";
        Desc = "Constraint applied on meta fails on instance";
        ErrorMsg = "Constraint applied on meta fails on instance";
    }
    entity Test_Constraint2i : Test_Constraint2 {
    }

