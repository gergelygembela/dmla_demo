    // -----------------------------------------------------------
    // ---------------  Cardinality constraint  ------------------
    // -----------------------------------------------------------
    @Test= {
        Name = "Card";
        Category = "Cardinality check";
        Desc = "Cardinality can be refined from 0..* -> 0..1";
    }
    entity Test_Card : Classifier {
        @Cardinality= {Min=0; Max=1;}
        slot OptionalSlot : Base.Fields;
    }

    @Test= {
        Name = "Card_ia";
        Category = "Cardinality check";
        Desc = "Cardinality can be refined from 0..1 -> 1..1";
    }
    entity Test_Cardi : Test_Card {
        @Cardinality= {Min=1; Max=1;}
        slot OptionalSlot : Test_Card.OptionalSlot;
    }

    @Test= {
        Name = "Card_ib";
        Category = "Cardinality check";
        Desc = "Cardinality can be refined from 0..1 -> 0..0";
    }
    entity Test_Cardib : Test_Card {
        @Cardinality= {Min=0; Max=0;}
        slot OptionalSlot : Test_Card.OptionalSlot;
    }

    @Test= {
        Name = "Card_ic";
        Category = "Cardinality check";
        Desc = "Cardinality cannot be refined from 0..1 -> 0..2";
        ErrorMsg = "Cardinality cannot be refined from 0..1 -> 0..2";
    }
    entity Test_Cardic : Test_Card {
        @Cardinality= {Min=0; Max=2;}
        slot OptionalSlot : Test_Card.OptionalSlot;
    }

    entity Test_Card_2 : Classifier {
        @Cardinality= {Min=2; Max=5;}
        slot NewSlot : Base.Fields;
    }

    @Test= {
        Name = "Card_2i";
        Category = "Cardinality check";
        Desc = "Cardinality cannot be refined from 2..5 -> 1..5";
