package BicycleDomain {
    import Bootstrap
    /*
      *
      * 											Basic building blocks
      * 										----------------------------
      */
    entity Configuration : Classifier {
        @Type= {TypeName=Component;}
        new slot Components;
    }

    entity Component : Configuration {
        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Number;}
        new slot Weight;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Number;}
        new slot Size;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=String;}
        new slot Colour;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=String;}
        new slot SerialNumber;

        override operation void ValidateGamma() {
            //Needs to be checked only once, not in all Component refinements
            if (this == Component){
                String[] serials=new String[];
                foreach(Component c in GetInstances(Component, true)) {
                    String? serial = c.Get(Component.SerialNumber);
                    if (serial !=null) {
                        if (serials.Contains(serial!!)) {
                            throw new ValidationException {
                                ValidationSource = this;
                                Meta = this;
                                Instances = new Base[];
                                Category = "Bicycle";
                                ErrorCode = "Component_1";
                                Message = "2d A component has properties, for example ...unique serial number. - Violated (serial ${serial!!} is duplicated)";
                            };
                        }
                        else serials.Add(serial!!);
                    }
                }
            }
        }
    }

    entity BasicPart : Component {    }

    /*
    *
    * 											Bicycle components
    * 										--------------------------
     */
    entity BicycleComponent : Component {
        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=BicycleMaterial;}
        new slot Material;
    }

    entity HandleBarComponent : BicycleComponent {    }
    entity WheelComponent : BicycleComponent {    }
    entity FrameComponent : BicycleComponent {    }
    entity ForkComponent : BicycleComponent {    }
    entity SeatComponent : BicycleComponent {    }
    entity SuspensionComponent : BicycleComponent {    }
    entity EnforcedBrakeComponent : BicycleComponent {    }
    entity BatteryComponent : BicycleComponent {    }
    entity RacingForkComponent : ForkComponent {    }

    entity RacingFrameComponent : FrameComponent {
        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Number;}
        new slot TopTubeLength;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Number;}
        new slot DownTubeLength;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Number;}
        new slot SeatTubeLength;

        override operation void Validate(Object subject, Base? context=null) {            
            BicycleMaterial? material = subject.Get(BicycleComponent.Material);
            
            //Material can be null here, since we may apply the validation for a partial refined raceframe 
            if (material != null && 
                    material!! !=  Material_Carbon &&
                    material!! != Material_Aluminium && 
                    material!! !=  Material_Steel)
                throw new ValidationException {
                    ValidationSource = this;
                    Meta = this;
                    Instances = new Base[subject];
                    Category = "Bicycle";
                    ErrorCode = "RaceFrame_1";
                    Message = "5.7 A racing frame is made of steel, aluminum, or carbon.";
                };
        }
    }

    entity ProRaceFrameComponent : RacingFrameComponent {

        override operation void Validate(Object subject, Base? context=null) {
            BicycleMaterial? material = subject.Get(BicycleComponent.Material);      
            if (material != null && material!! != Material_Carbon && material!! != Material_Aluminium)
                throw new ValidationException {
                    ValidationSource = this;
                    Meta = null;
                    Instances = new Base[subject];
                    Category = "Bicycle";
                    ErrorCode = "ProRaceFrame_1";
                    Message = "5.9b  ... has a professional race frame which is made of aluminum or carbon";
                };

            Number? weight = subject.Get(Component.Weight);
            if (weight != null && weight!! < 5200)
                throw new ValidationException {
                    ValidationSource = this;
                    Meta = null;
                    Instances = new Base[subject];
                    Category = "Bicycle";
                    ErrorCode = "ProRaceFrame_2";
                    Message = "5.9b  ... and has a minimum weight of 5200 gr.";
                };
        }
    }

    entity RocketA1XL : ProRaceFrameComponent {
        slot Weight : Component.Weight = 5920;
    }

/*
 *
 * 											Bicycle types
 * 										----------------------
 */
    entity Bicycle : Configuration {
        @Cardinality={Min=1; Max=-1;}
        @Type= {TypeName=WheelComponent;}
        new slot Wheel : Configuration.Components;

        @Cardinality={Min=0; Max=1;}
        @Type= {TypeName=Bool;}
        new slot IsEquippedWIthElectricMotor;

        @Cardinality={Min=1; Max=-1;}
        @Type= {TypeName=ForkComponent;}
        new slot Fork : Configuration.Components;

        @Cardinality={Min=1; Max=-1;}
        @Type= {TypeName=SeatComponent;}
        new slot Seat : Configuration.Components;

        @Cardinality={Min=1; Max=-1;}
        @Type= {TypeName=FrameComponent;}
        new slot Frame : Configuration.Components;

        slot OtherComponents : Configuration.Components;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Number;}
        new slot SalesPrice;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Person;}
        new slot CategoryManager;

        override operation void Validate(Object subject, Base? context=null) {

            Bool? hasElectricMotor = subject.Get(Bicycle.IsEquippedWIthElectricMotor);
            if (hasElectricMotor != null && hasElectricMotor) {
                Bool hasEnforcedBrake = false;
                Bool hasBattery = false;

                foreach(Base b in subject.GetAllAttributesByType(Bicycle.OtherComponents)) {
                    if (GetValue(b) is EnforcedBrakeComponent)
                        hasEnforcedBrake = true;

                    if (GetValue(b) is BatteryComponent)
                        hasBattery = true;
                }

                if (!hasEnforcedBrake || !hasBattery)
                {
                    throw new ValidationException {
                        ValidationSource = this;
                        Meta = this;
                        Instances = new Base[subject];
                        Category = "Bicycle";
                        ErrorCode = "Bicycle_1";
                        Message = "5 ... Electric bikes need enforced brakes and a battery.";
                    };
                }

            }

            FrameComponent? f=subject->Frame;
            BicycleMaterial? material= f==null?null:f->Material;
            if (material == null || material!! != Material_Carbon) return;
            foreach (WheelComponent wComponent in subject.GetAll(Bicycle.Wheel)) {
                    if (wComponent->Material!=null && wComponent->Material != Material_Carbon && wComponent->Material!= Material_Aluminium)
                            throw new ValidationException {
                                ValidationSource = this;
                                Meta = null;
                                Instances = new Base[subject];
                                Category = "Bicycle";
                                ErrorCode = "Bicycle_2";
                                Message = "5.10 A carbon frame allows for carbon wheels or aluminum wheels only.";
                            };
            }
  
        }

        operation Bool IsSuitableFor(SuitablePurposes purpose) {
            return true;
        }

        operation Number GetAvarageActualSalesPrice() {
            Number sum = 0;
            Number cnt = 0;

            foreach (SellingAct act in GetInstances(SellingAct, true)) {

                //Only non-abstract selling acts are counted
                Bicycle? soldBike = act.Get(SellingAct.SoldBicycle);
                if (soldBike!!.isTransitiveInstance(this)) {
                    cnt = cnt + 1;
                    sum = sum + act.Get(SellingAct.SalesPrice);
                }
            }
            if (cnt > 0)
                return sum / cnt;
            else
                return 0;
        }


        operation Number GetAvarageRegularSalesPrice() {
            Number sum = 0;
            Number cnt = 0;

            foreach (SellingAct act in GetInstances(SellingAct, true)) {
            
                //Only non-abstract selling acts are counted
                Bicycle? soldBike = act.Get(SellingAct.SoldBicycle);
                if (soldBike!!.isTransitiveInstance(this)) {
                    cnt = cnt + 1;
                    sum = sum + soldBike!!.Get(Bicycle.SalesPrice);
                }
            }
            if (cnt > 0)
                return sum / cnt;
            else
                return 0;
        }
    }

    entity ClassicBike : Bicycle {
        @Cardinality={Min=1; Max=1;}
        slot FrontWheel : Bicycle.Wheel;

        @Cardinality={Min=1; Max=1;}
        slot RearWheel : Bicycle.Wheel;

        @Cardinality={Min=1; Max=1;}
        slot Seat : Bicycle.Seat;

        override operation void Validate(Object subject, Base? context=null) {
                WheelComponent? fw = subject.Get(ClassicBike.FrontWheel);
                WheelComponent? rw = subject.Get(ClassicBike.RearWheel);
                
                if (fw!=null && rw!=null && fw->Size!=rw->Size) {
                    throw new ValidationException {
                        ValidationSource = this;
                        Meta = this;
                        Instances = new Base[subject];
                        Category = "Bicycle";
                        ErrorCode = "ClassicBike_1";
                        Message = "3b Front wheel and rear wheel must have the same size. ";
                    };
                }
        }
    }

    entity TandemBike : Bicycle {
        @Cardinality={Min=1; Max=1;}
        slot FrontWheel : Bicycle.Wheel;

        @Cardinality={Min=1; Max=1;}
        slot RearWheel : Bicycle.Wheel;

        @Cardinality={Min=2; Max=2;}
        slot Seat : Bicycle.Seat;
    }

    entity UniCycle : Bicycle {
        @Cardinality={Min=1; Max=1;}
        slot Wheel : Bicycle.Wheel;

        @Cardinality={Min=1; Max=1;}
        slot Seat : Bicycle.Seat;
    }

    entity Tricycle : Bicycle {
        @Cardinality={Min=3; Max=3;}
        slot Wheel : Bicycle.Wheel;

        @Cardinality={Min=1; Max=1;}
        slot Seat : Bicycle.Seat;
    }

    entity RaceBike : ClassicBike {
        @Type= {TypeName=RacingFrameComponent;}
        slot Frame : Bicycle.Frame;

        @Type= {TypeName=RacingForkComponent;}
        slot Fork : Bicycle.Fork;

        slot CategoryManager : Bicycle.CategoryManager = PeterParker;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Bool;}
        new slot CertifiedByUCI;

        override operation Bool IsSuitableFor(SuitablePurposes purpose) {
            return (purpose != SuitableFor_ToughTerrain);
        }
    }
    
    entity PeterParker : Person {
    }

    entity MountainBike : ClassicBike {
        
        @Cardinality={Min=0; Max=1;}
        @Type= {TypeName=SuspensionComponent;}
        new slot Suspension : Bicycle.OtherComponents;

        @Cardinality={Min=0; Max=1;}
        @Type= {TypeName=SuspensionComponent;}
        new slot RearSuspension : Bicycle.OtherComponents;
    }

    entity CityBike : ClassicBike {
        @Cardinality={Min=0; Max=1;}
        @Type= {TypeName=SuspensionComponent;}
        new slot Suspension : Bicycle.OtherComponents;
    }

    entity ProRaceBike : RaceBike {
        @Type= {TypeName=ProRaceFrameComponent;}
        slot Frame : RaceBike.Frame;

        slot CertifiedByUCI : RaceBike.CertifiedByUCI = true;
    }

    entity ChallengerA2XL : ProRaceBike {
        @Type= {TypeName=RocketA1XL;}
        slot Frame : ProRaceBike.Frame;

        slot SalesPrice : Bicycle.SalesPrice = 4999;

        override operation Bool IsSuitableFor(SuitablePurposes purpose) {
            if (purpose == SuitableFor_ShortCyclist)
                return false;
        
            return RaceBike.IsSuitableFor(purpose);
        }
    }

    /*
    *
    * 											Sales
    * 										-------------
    */
    entity Customer : Classifier {    }
    entity Organization : Customer {    }
    entity Person : Customer {    }

    entity BusinessDocument : Classifier {
        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Bool;}
        new slot IsReadOnly;
    }
    entity Invoice : BusinessDocument {
        slot IsReadOnly : BusinessDocument.IsReadOnly = true;
    }

    entity DateTime : Classifier {
        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Number;}
        new slot Year;
    }

    entity SellingAct : Classifier {
        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Invoice;}
        new slot Invoice;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=DateTime;}
        new slot SellDate;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Number;}
        new slot SellingPrice;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Bicycle;}
        new slot SoldBicycle;

        @Cardinality={Min=1; Max=1;}
        @Type= {TypeName=Customer;}
        new slot SoldTo;

        override operation void Validate(Object subject, Base? context=null) {

                //TODO: Check
               Number? price = subject.Get(SellingAct.SellingPrice);
                if (subject.Get(SellingAct.SoldBicycle) != null && price != null) {
                    Number? regularPrice = subject.Get(Bicycle.SalesPrice);
                    if (regularPrice != null && regularPrice < price)
                    {
                        throw new ValidationException {
                            ValidationSource = this;
                            Meta = this;
                            Instances = new Base[subject];
                            Category = "Bicycle";
                            ErrorCode = "SellingAct_1";
                            Message = "10c  The actual sales price of physical instances of the bicycle model, i.e., the price given in an invoice, may be lower.";
                        };
                    }
                }
        }
    }

    /*
     *
     * 											Enumerations
     * 										---------------------
     */
    entity BicycleEnum : Classifier {    }

    entity SuitablePurposes : BicycleEnum {    }    
    entity SuitableFor_ToughTerrain : SuitablePurposes {    }    
    entity SuitableFor_Race : SuitablePurposes {    }    
    entity SuitableFor_City : SuitablePurposes {    }    
    entity SuitableFor_TallCyclist : SuitablePurposes {    }    
    entity SuitableFor_ShortCyclist : SuitablePurposes {    }
    
    entity BicycleMaterial : BicycleEnum {}    
    entity Material_Steel : BicycleMaterial {    }    
    entity Material_Aluminium : BicycleMaterial {    }    
    entity Material_Carbon : BicycleMaterial {    }    
    entity Material_Plastic : BicycleMaterial {    }
}