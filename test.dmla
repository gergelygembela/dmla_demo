package UnitTests {
    import Bootstrap

    entity Test: Annotation {
        @Type= {TypeName=String;}
        new slot Name;

        @Type= {TypeName=String;}
        new slot Desc;

        @Type= {TypeName=String;}
        new slot Category;

        @Type= {TypeName=String;}
        new slot ErrorMsg;
    }

    operation void TestAll(){
        RunAllTests(Base);
    }

    operation Bool RunAllTests(Base rootEntity) {
        foreach (Base subject in GetInstances(rootEntity, true)) {
            if (subject.HasAnnotation(Test, false)) {
                Test testAnnotation = subject.GetAttributeByType(Test)!!;
                Bool success = true;
                String? msg=null;

                if (testAnnotation->ErrorMsg!=null) {
                    if (ValidateSelf(subject)==null) {
                            success = false;
                            msg = testAnnotation->ErrorMsg;
                    }
                }
                else {                    
                    msg = ValidateSelf(subject);
                    success = msg==null;
                }

                Print("Testing ${testAnnotation.Get(Test.Name)} '${testAnnotation->Desc}': ", "white");
                if (success)
                    PrintLn("   [ OK ]  ", "green");
                else
                    PrintLn("  [Fail] ('${msg}')", "red");
            }
        }

        return true;
    }

     @Test= {
        Name = "Gen_Instantiate";
        Category = "General";
        Desc = "An empty entity is a valid instance of Base";        
    }
    entity Test_G_1 : Base {
    }

    @Test= {
        Name = "Gen_Instantiate";
        Category = "General";
        Desc = "An empty entity is a valid instance of Classifier";
    }
    entity Test_G_2 : Classifier {
    }

	 @Test= {
        Name = "Gen_Instantiate3";
        Category = "General";
        Desc = "Validate can be overriden";
    }
    entity Test_G_3 : Base {
        override operation void Validate(Object subject, Base? context= null) {
            throw new ValidationException {
                ValidationSource = this;
                Meta = GetMeta(this);
                Instances = new Base[];
                Category = "TestModel";
                ErrorCode = "TestModel_G3";
                Message = "Validate test - should fail";
            };
        }
    }

    @Test= {
        Name = "Gen_Instantiate3i";
        Category = "General";
        Desc = "Failing validate causes validation error";
        ErrorMsg= "Failing validate should cause validation error";
    }
    entity Test_G_3i : Test_G_3 {
    }

	entity Test_G_3i2 : Test_G_3 {
        override operation void Validate(Object subject, Base? context= null) {
            return;
        }
    }

    @Test= {
        Name = "Gen_Instantiate3i2i";
        Category = "General";
        Desc = "Trying to override (hack) failing validation";
        ErrorMsg ="Cannot relax failing validation";
    }
    entity Test_G_3i2i : Test_G_3i2 {
    }

