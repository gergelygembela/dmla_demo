    @Test= {
        Name = "Card_3";
        Category = "Cardinality check";
        Desc = "Omit + division from Base.Fields";
    }
    entity Test_Card_3 : Classifier {
        @Cardinality= {Min=2; Max=6;}
        slot NewSlot : Base.Fields;
    }

    @Test= {
        Name = "Card_3i";
        Category = "Cardinality check";
        Desc = "Trying to refine omitted Base.Fields";
        ErrorMsg = "Trying to refine omitted Base.Fields";
    }
    entity Test_Card_3i : Test_Card_3 {
        slot NewSlot2 : Base.Fields;
    }

    @Test= {
        Name = "Card_3ib";
        Category = "Cardinality check";
        Desc = "Division exceeds maximum cardinality (single instance division)";
        ErrorMsg = "Division exceeds maximum cardinality (single instance division)";
    }
    entity Test_Card_3ib : Test_Card_3 {
        @Cardinality= {Min=1; Max=3;}
        slot NewSlot2 : Test_Card_3.NewSlot;

        @Cardinality= {Min=1; Max=5;}
        slot NewSlot3 : Test_Card_3.NewSlot;
    }


    @Test= {
        Name = "Card_3ic";
        Category = "Cardinality check";
        Desc = "Refining without 'new', minimum cardinality is violated";
        ErrorMsg = "Refining without 'new', minimum cardinality is violated";
    }
    entity Test_Card_3ic : Test_Card_3 {
        @Cardinality= {Min=1; Max=3;}
        slot NewSlot2 : Test_Card_3.NewSlot;
    }

